# Legacy AI — Ticket Board · environment

# Login for the /board studio (runtime). SET THIS in any real deploy: the API
# fails closed without it (only the TICKETS_TOKEN / TICKETS_API_TOKEN service
# tokens can write — and those may never DELETE; see the delete boundary).
STUDIO_PASSWORD=

# Bearer the nexus gateway presents to this app (Authorization: Bearer …).
# Convention (nexus): slug "tickets" -> TICKETS_API_TOKEN. openssl rand -hex 32
TICKETS_API_TOKEN=

# Optional service token the MCP server / Autopilot present to write
# (header x-tickets-token). openssl rand -hex 32
TICKETS_TOKEN=

# Where the board JSON is stored (a mounted volume in Docker).
# Fallback chain: TICKETS_DATA_DIR ?? DATA_DIR ?? /data
TICKETS_DATA_DIR=/data
